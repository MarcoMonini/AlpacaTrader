# Alpaca market-data credentials. Paper-account keys are enough: this project reads bars and
# places no orders. Names are Alpaca's own, so any other tool in the ecosystem reads them too.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# iex on the free plan, sip with a market-data subscription. See CLAUDE.md on why the choice is
# not cosmetic: IEX is ~2-3% of the volume and a biased sample at intraday frequency.
ALPACA_FEED=iex
